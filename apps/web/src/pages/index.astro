---
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070a0d" />
    <title>EVO | Engineering, Automation & Smart Living</title>
    <meta
      name="description"
      content="EVO brings together industrial automation, smart living, and custom engineering solutions in one modern engineering platform."
    />
  </head>
  <body>
    <SiteHeader />
    <main>
      <Hero />

      <section class="next-section" id="solutions">
        <div class="container next-section-inner">
          <p class="eyebrow">NEXT SECTION</p>
          <h2>Solutions and services will be built here after the hero is approved.</h2>
          <p>
            This placeholder intentionally keeps the first visual review focused on the header, navigation, design system, and hero only.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
