---
import InnerLayout from '../layouts/InnerLayout.astro';
import ProjectPlaceholder from '../components/ProjectPlaceholder.astro';
import { portfolioProjects } from '../data/projectPortfolio';
---

<InnerLayout
  title="Projects | EVO"
  description="Selected real engineering, automation, CNC modernization, machinery recovery, smart living and infrastructure projects from the EVO project archive."
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div class="page-hero-copy">
        <p class="eyebrow">REAL PROJECT PORTFOLIO</p>
        <h1>Engineering proven in <span>real working environments.</span></h1>
        <p>Selected real projects from our growing archive, spanning CNC modernization, industrial machinery recovery, automation, smart living and technical infrastructure. Approved project photography will be added into the reserved media spaces as the portfolio is prepared for public release.</p>
        <div class="page-hero-actions">
          <a class="page-button page-button-primary" href="/contact">Start a Project ↗</a>
          <a class="page-button page-button-secondary" href="/solutions">Explore Solutions</a>
        </div>
      </div>
      <div class="page-hero-visual" aria-hidden="true">
        <div class="page-orb"></div>
        <ProjectPlaceholder icon="cnc" label="PROJECT PORTFOLIO MEDIA" />
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container page-section-inner">
      <div class="page-section-heading">
        <div>
          <p class="eyebrow">SELECTED REAL WORK</p>
          <h2>Different fields. <span>One engineering mindset.</span></h2>
        </div>
        <p>This first portfolio set is intentionally selective. It uses only archive-supported facts and keeps client-sensitive information out until public-use permissions and final media selections are confirmed.</p>
      </div>

      <div class="portfolio-list-grid">
        {portfolioProjects.map((project) => (
          <article class="portfolio-list-card">
            <ProjectPlaceholder icon={project.icon} label="REAL PHOTO SPACE" />
            <div class="portfolio-list-copy">
              <div class="portfolio-list-meta">
                <span>{project.category}</span>
                <span class="portfolio-card-badge">{project.status === 'Ongoing' ? `ONGOING · ${project.period}` : project.period}</span>
              </div>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              {project.preEvo && <div class="portfolio-pre-evo">PRE-EVO PROFESSIONAL EXPERIENCE</div>}
              <a class="portfolio-card-link" href={`/projects/${project.slug}`}>
                View Project <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-panel">
      <div>
        <p class="eyebrow">THE ARCHIVE KEEPS GROWING</p>
        <h2>More real projects will be added <span>as evidence is prepared.</span></h2>
        <p>The portfolio is being built from the EVO Project Archive, with project facts, technical scope and media reviewed before public use.</p>
      </div>
      <a class="page-button page-button-primary" href="/contact">Talk to EVO ↗</a>
    </div>
  </section>
</InnerLayout>
