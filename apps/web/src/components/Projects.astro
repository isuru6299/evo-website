---
import ProjectPlaceholder from './ProjectPlaceholder.astro';
import { homepageProjects } from '../data/projectPortfolio';
---

<section class="projects-section" id="projects">
  <div class="container projects-inner">
    <div class="projects-heading">
      <div>
        <p class="eyebrow">SELECTED REAL WORK</p>
        <h2>Engineering that moves from <span>problem to working system.</span></h2>
      </div>
      <p>
        A growing portfolio of real automation, machinery recovery, CNC modernization and infrastructure work. Real project photography will replace the reserved media spaces as each project is cleared for website use.
      </p>
    </div>

    <div class="portfolio-home-grid">
      {homepageProjects.map((project) => (
        <article class="portfolio-card">
          <ProjectPlaceholder icon={project.icon} label="PROJECT PHOTO SPACE" compact />
          <div class="portfolio-card-copy">
            <div class="portfolio-card-top">
              <span>{project.category}</span>
              <span class="portfolio-card-badge">{project.period}</span>
            </div>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            {project.preEvo && <div class="portfolio-pre-evo">PRE-EVO PROFESSIONAL EXPERIENCE</div>}
            <a class="portfolio-card-link" href={`/projects/${project.slug}`}>
              View Project <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="portfolio-section-action">
      <a href="/projects">View the project portfolio <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
