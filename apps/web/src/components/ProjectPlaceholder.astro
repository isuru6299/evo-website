---
import type { ProjectIcon } from '../data/projectPortfolio';

interface Props {
  icon: ProjectIcon;
  label?: string;
  compact?: boolean;
}

const { icon, label = 'REAL PROJECT MEDIA', compact = false } = Astro.props;
---

<div class:list={['project-media-placeholder', `project-media-${icon}`, { 'project-media-compact': compact }]} aria-label={label}>
  <span class="project-media-label">{label}</span>
  <div class="project-media-icon" aria-hidden="true">
    {icon === 'cnc' && (
      <svg viewBox="0 0 120 120"><rect x="20" y="31" width="80" height="58" rx="12"/><path d="M35 45h50M35 58h30M32 89v12M88 89v12"/><circle cx="79" cy="58" r="7"/><path d="M44 73h32M60 73v13"/></svg>
    )}
    {icon === 'recovery' && (
      <svg viewBox="0 0 120 120"><path d="M29 78h62l-7-42H36z"/><path d="M43 36v-9h34v9M40 78l-8 18M80 78l8 18"/><path d="M50 51l20 20M70 51L50 71"/><path d="M24 93h72"/></svg>
    )}
    {icon === 'network' && (
      <svg viewBox="0 0 120 120"><rect x="18" y="29" width="84" height="23" rx="6"/><rect x="18" y="68" width="84" height="23" rx="6"/><path d="M31 41h8M47 41h8M63 41h8M31 80h8M47 80h8M63 80h8"/><circle cx="88" cy="41" r="3"/><circle cx="88" cy="80" r="3"/><path d="M60 52v16"/></svg>
    )}
    {icon === 'rack' && (
      <svg viewBox="0 0 120 120"><rect x="31" y="17" width="58" height="86" rx="8"/><path d="M41 34h38M41 48h38M41 62h38M41 76h38M41 90h38"/><circle cx="47" cy="34" r="2"/><circle cx="47" cy="62" r="2"/><circle cx="47" cy="90" r="2"/></svg>
    )}
    {icon === 'automation' && (
      <svg viewBox="0 0 120 120"><rect x="22" y="20" width="76" height="80" rx="10"/><rect x="35" y="34" width="50" height="25" rx="5"/><path d="M42 47h11l7-7 8 13 7-8h5"/><circle cx="42" cy="76" r="5"/><circle cx="60" cy="76" r="5"/><circle cx="78" cy="76" r="5"/><path d="M38 90h44"/></svg>
    )}
    {icon === 'telecom' && (
      <svg viewBox="0 0 120 120"><path d="M60 89V52M46 89h28"/><circle cx="60" cy="42" r="7"/><path d="M43 58c-9-9-9-24 0-33M77 58c9-9 9-24 0-33M34 68c-15-15-15-40 0-55M86 68c15-15 15-40 0-55"/></svg>
    )}
    {icon === 'fire' && (
      <svg viewBox="0 0 120 120"><path d="M61 17c8 18-2 26-8 35-7 10-7 24 7 31 14-7 19-20 13-32 11 7 18 18 18 31 0 18-14 31-31 31S29 100 29 82c0-17 11-28 22-39 7-7 11-14 10-26z"/><path d="M60 62c6 8 8 14 4 22-4 7-12 7-16 1-4-7 0-15 12-23z"/></svg>
    )}
    {icon === 'packaging' && (
      <svg viewBox="0 0 120 120"><path d="M28 39h64v55H28z"/><path d="M28 39l16-15h48L76 39M76 39v55"/><path d="M52 58h16M52 70h16"/><circle cx="45" cy="84" r="4"/></svg>
    )}
    {icon === 'conveyor' && (
      <svg viewBox="0 0 120 120"><rect x="20" y="48" width="80" height="27" rx="10"/><circle cx="34" cy="61.5" r="8"/><circle cx="56" cy="61.5" r="8"/><circle cx="78" cy="61.5" r="8"/><path d="M30 75l-8 18M90 75l8 18M18 93h84"/></svg>
    )}
    {icon === 'smart-home' && (
      <svg viewBox="0 0 120 120"><path d="M22 57l38-31 38 31"/><path d="M31 53v43h58V53"/><rect x="48" y="68" width="24" height="28" rx="4"/><path d="M43 57c9-8 25-8 34 0M49 63c6-5 16-5 22 0"/><circle cx="60" cy="71" r="2"/></svg>
    )}
  </div>
  <div class="project-media-accent" aria-hidden="true"></div>
</div>
